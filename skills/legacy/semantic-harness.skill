name: semantic-harness

purpose: >
  Route semantic construction based on repository semantic state.

inputs:
  - repository_root
  - sampling_mode: auto | confirm
  - sampling_timeout: optional

logic:
  - if: no versioned discovery artifacts exist
    run: repo-semantic-discovery.skill
  - elif: no accepted baseline exists
    run: semantic-refinement.skill
  - else: report semantic baseline exists and wait for new architect feedback

outputs:
  - routed action
  - next recommended step
